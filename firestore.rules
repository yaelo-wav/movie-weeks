rules_version = '2';
// Firestore security rules for Opening Weeks. Paste into Firebase console → Firestore Database → Rules → Publish.
//
// users/{uid}          your account: name, username, watchlist, watched, friends. Only you can write it;
//                      people you've added as friends can read it.
// usernames/{name}     unique usernames ({ uid, name }), so friends can find you. Readable when signed in.
// requests/{from_to}   friend requests. Only the sender and the receiver can see them; the receiver can accept.
// groups/{code}        old invite-code groups, only read to turn them into friendships.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid in resource.data.get('friends', []));
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && name.matches('^[a-z0-9_.]{3,20}$');
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /requests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    match /groups/{code} {
      allow read: if signedIn();
    }
  }
}
